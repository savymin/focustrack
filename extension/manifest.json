{
  "manifest_version": 3,
  "name": "Google Meet Student Focus Monitor",
  "version": "1.0",
  "description": "Monitors tab switching and idle state during Google Meet classes.",
  "permissions": [
    "tabs",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"]
    }
  ]
}